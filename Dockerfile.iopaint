FROM python:3.11-slim

WORKDIR /app

# Install minimal system dependencies for LaMa / IOPaint
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install IOPaint (LaMa only - this is the heaviest layer)
RUN pip install --no-cache-dir iopaint

# Expõe a porta
EXPOSE 8080

# Comando padrão (pode ser sobrescrito no docker-compose)
CMD ["iopaint", "run", "--model", "lama", "--device", "cpu", "--port", "8080"]
