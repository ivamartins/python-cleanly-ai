# ==========================================
# Cleanly - Environment Variables Example
# ==========================================
# Copy this file to .env and fill in the values

# Required: Secret key for JWT tokens (generate a strong random string)
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-here-at-least-32-characters

# Optional - Token expiration times (in minutes / days)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional - URL of the IOPaint service (only needed if running outside Docker)
# IOPAINT_URL=http://localhost:8080

# Note:
# When running with Docker Compose, DATABASE_URL and IOPAINT_URL
# are automatically configured in docker-compose.yml
